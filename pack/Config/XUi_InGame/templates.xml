<configs>

    <!-- Check mark in the top right corner of an item slot. The binding is answered by the mod,
         see Patches.cs. Vanilla puts its own overlays (favorite, lock, item type) in the top
         left corner, so this one does not collide with them. -->
    <append xpath="/templates/item_stack/rect">
        <sprite depth="9" name="readBookMarker" width="24" height="24" sprite="ui_game_symbol_check"
                pos="${-26+cell_size},-2" foregroundlayer="true"
                color="90,220,90,255" visible="{rbmknown}" />
    </append>

    <!-- The trader's stock list uses its own row template, so the mark goes on separately.
         The item icon there is centred at 34,-22 and is 38 wide, so its top right corner sits
         around x=53: place a smaller mark just inside it. -->
    <append xpath="/templates/trader_item/rect">
        <sprite depth="9" name="readBookMarker" width="16" height="16" sprite="ui_game_symbol_check"
                pos="40,-4" foregroundlayer="true"
                color="90,220,90,255" visible="{rbmknown}" />
    </append>

    <!-- Reward picker when handing a quest in. Its item icon is centred at 34,-25, 38 wide. -->
    <append xpath="/templates/quest_turnin_entry/rect">
        <sprite depth="9" name="readBookMarker" width="16" height="16" sprite="ui_game_symbol_check"
                pos="40,-7" foregroundlayer="true"
                color="90,220,90,255" visible="{rbmknown}" />
    </append>

</configs>
